<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer (MSI) for Cloud Mastery. Built by deploy/windows/build-msi.sh
  with msitools (wixl); content.wxs and web.wxs are generated by wixl-heat.

  Installs to "C:\Program Files\Cloud Mastery": gcplab.exe, content\ and web\.
  Learner data lives in %LOCALAPPDATA%\CloudMastery and survives upgrades and
  uninstalls. The UpgradeCode never changes: a newer MSI replaces the old one.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Cloud Mastery" Language="3082" Codepage="1252"
           Version="$(var.Version)" Manufacturer="NeoDevESP"
           UpgradeCode="4F6DBB38-B3AD-4037-9312-F2E6AAB57217">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Languages="3082" SummaryCodepage="1252"
             Description="Cloud Mastery: simulador de laboratorios de Google Cloud"
             Comments="Aprende Google Cloud haciendo el trabajo." Manufacturer="NeoDevESP"/>
    <Media Id="1" Cabinet="app.cab" EmbedCab="yes"/>
    <MajorUpgrade DowngradeErrorMessage="Ya hay una version mas reciente de Cloud Mastery instalada."/>

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/neodevesp/gcp-trainer"/>
    <Property Id="ARPCOMMENTS" Value="Laboratorios de Google Cloud en local, sin conexion a la nube."/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Cloud Mastery">
          <Directory Id="CONTENTDIR" Name="content"/>
          <Directory Id="WEBDIR" Name="web"/>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenuDir" Name="Cloud Mastery"/>
      </Directory>
      <Directory Id="DesktopFolder"/>
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MainExecutable" Guid="7C1E0D36-6B3B-4E0B-9C2F-3C0C5E7B2A11" Win64="yes">
        <File Id="GcplabExe" Name="gcplab.exe" Source="$(var.ExeDir)/gcplab.exe" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="AppMenuDir">
      <Component Id="StartMenuShortcuts" Guid="2B9E5F54-0A3C-4C6E-8C1D-5E8F7A6B4C21" Win64="yes">
        <Shortcut Id="StartMenuShortcut" Name="Cloud Mastery" Description="Abrir Cloud Mastery en el navegador"
                  Target="[INSTALLDIR]gcplab.exe" Arguments="-desktop" WorkingDirectory="INSTALLDIR"/>
        <RemoveFolder Id="RemoveAppMenuDir" On="uninstall"/>
        <RegistryValue Root="HKLM" Key="Software\NeoDevESP\CloudMastery" Name="StartMenuShortcut"
                       Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="9D4A7B12-3E5F-4A6B-8C7D-1E2F3A4B5C31" Win64="yes">
        <Shortcut Id="DesktopShortcutLink" Name="Cloud Mastery" Description="Abrir Cloud Mastery en el navegador"
                  Target="[INSTALLDIR]gcplab.exe" Arguments="-desktop" WorkingDirectory="INSTALLDIR"/>
        <RegistryValue Root="HKLM" Key="Software\NeoDevESP\CloudMastery" Name="DesktopShortcut"
                       Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="Cloud Mastery" Level="1">
      <ComponentRef Id="MainExecutable"/>
      <ComponentRef Id="StartMenuShortcuts"/>
      <ComponentRef Id="DesktopShortcut"/>
      <ComponentGroupRef Id="ContentFiles"/>
      <ComponentGroupRef Id="WebFiles"/>
    </Feature>
  </Product>
</Wix>
